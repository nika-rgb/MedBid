<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
    <packaging>pom</packaging>
    <modules>
        <module>medbid-api</module>
		<module>medbid-business</module>
	</modules>
    <parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.1.4</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.medbid</groupId>
	<artifactId>medBid</artifactId>
	<version>1.0.0</version>
	<name>MedBid</name>
	<description>Medbid is an auction type platform for medical purposes.</description>
	<properties>
		<java.version>17</java.version>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<keycloak-spring-boot-starter.version>22.0.4</keycloak-spring-boot-starter.version>
		<json.version>20230227</json.version>
		<lombok.version>1.18.36</lombok.version>
		<apache-commons.vesion>3.17.0</apache-commons.vesion>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.projectlombok</groupId>
				<artifactId>lombok</artifactId>
				<version>${lombok.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-lang3</artifactId>
				<version>${apache-commons.vesion}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
